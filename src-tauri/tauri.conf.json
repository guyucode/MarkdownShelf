{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkdownShelf",
  "version": "0.2.0",
  "identifier": "dev.guyucode.markdownshelf",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "文架 · MarkdownShelf",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "legal/LICENSE",
      "../NOTICE": "legal/NOTICE",
      "../release-legal/": "legal/dependencies/"
    }
  }
}
